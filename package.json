{
  "name": "zutnik-pwa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:full",
    "dev:web": "vite",
    "dev:api": "node server/index.mjs",
    "dev:full": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "icons": "node scripts-generate-icons.mjs",
    "test": "npm run test:mappers && npm run test:upstream-browser && npm run test:timetable && npm run test:network && npm run test:unit",
    "test:network": "node --test server/usos/read-cache.test.mjs server/stats/service.test.mjs",
    "test:mappers": "node --test server/usos/mappers.test.mjs server/usos/payments.test.mjs",
    "test:upstream-browser": "node server/upstream-browser.test.mjs",
    "test:timetable": "node --test server/usos/timetable.test.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-condensed": "^5.2.8",
    "chart.js": "^4.5.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^1.52.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "undici": "^7.22.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "happy-dom": "^20.14.5",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
